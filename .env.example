# Copie para .env (que não vai para o git) e preencha localmente.
# Caminho dos agentes: github-native liga a criação de issue origin:app para cada ticket novo.
AGENT_RUNTIME=github-native
# Mantenha true até o ensaio: nada é enviado ao GitHub, só registrado no log.
AGENT_DRY_RUN=true
GITHUB_REPO=implantacaoarpa-alt/fluxo-tarefas-atendimento
# Credencial LOCAL do backend (criar issue e ler comentários). Não é o COPILOT_AGENT_TOKEN das Actions.
FLUXO_GITHUB_TOKEN=
# Runtime github-actions (IA própria): use AGENT_RUNTIME=github-actions. O backend reaproveita o `gh` já
# logado (GH_BIN aponta o executável, se não estiver no PATH). A AI_API_KEY NÃO fica aqui: é secret das Actions.
# GH_BIN=C:/Program Files/GitHub CLI/gh.exe
